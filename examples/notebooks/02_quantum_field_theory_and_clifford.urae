# URAE Mathematics Notepad: Quantum Field Theory & Space-Time Clifford Algebra
# Interactive workspace for Dirac gamma traces, spinor helicity, Parke-Taylor amplitudes, and multivector rotors.

# Dirac Gamma Matrix Cl(1, 3) algebra: {gamma^mu, gamma^nu} = 2 eta^{mu nu} I
dirac_trace([0, 1, 0, 1])
dirac_trace([0, 1, 2, 3])

# Massless Weyl Spinors & Lorentz Invariant Brackets
# <1 2> [2 1] = 2 (p1 . p2) = s_12
spinor_bracket_angle(1, 2)
spinor_bracket_square(2, 1)

# Parke-Taylor Tree-Level MHV 4-Gluon Scattering Amplitude
# A(1-, 2-, 3+, 4+) = <1 2>^4 / (<1 2><2 3><3 4><4 1>)
parke_taylor_mhv(4, [1, 2])

# Passarino-Veltman 1-Loop Tensor Reduction
passarino_veltman_b0(100.0, 0.0, 0.0)
passarino_veltman_b1(100.0, 0.0, 0.0)
